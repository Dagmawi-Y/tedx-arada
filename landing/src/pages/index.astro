---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero";
import About from "../components/About";
import Speakers from "../components/Speakers";
import Schedule from "../components/Schedule";
import Sponsors from "../components/Sponsors";
import PreviousEvents from "../components/PreviousEvents";
import Footer from "../components/Footer.astro";
import { getCurrentEvent } from "../data/events";

const event = getCurrentEvent();
---

<Layout title={event.seo.title} description={event.seo.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": event.seo.eventName,
    "startDate": event.date.schemaStart,
    "endDate": event.date.schemaEnd,
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": {
      "@type": "Place",
      "name": event.venue.name,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": event.venue.city,
        "addressRegion": "Arada",
        "addressCountry": "ET"
      }
    },
    "image": ["https://tedxarada.com/images/og-image.jpg"],
    "description": event.seo.description,
    "organizer": {
      "@type": "Organization",
      "name": "TEDxArada",
      "url": "https://tedxarada.com"
    },
    "offers": {
      "@type": "Offer",
      "url": event.registrationUrl,
      "availability": "https://schema.org/InStock"
    }
  })} />
  <Navbar client:load />
  <main>
    <Hero client:load />

    <div id="theme" class="scroll-mt-0 content-auto">
      <About client:visible />
    </div>

    <div id="speakers" class="scroll-mt-0 content-auto">
      <Speakers client:visible />
    </div>

    <div id="schedule" class="scroll-mt-0 content-auto">
      <Schedule client:visible />
    </div>

    <div id="sponsors" class="scroll-mt-0 content-auto">
      <Sponsors client:visible />
    </div>

    <PreviousEvents client:visible />

    <Footer />
  </main>
</Layout>
